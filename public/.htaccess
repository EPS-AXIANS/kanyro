# Configuration Apache pour hébergement mutualisé OVH.
#
# Ce fichier remplace ce que netlify.toml fournissait : en-têtes de sécurité,
# cache des assets, et URL propres. Il est dans public/ donc copié tel quel à la
# racine de dist/ à chaque build.
#
# ⚠ La politique CSP ci-dessous doit rester le miroir de celle générée dans
# src/layouts/Base.astro, avec en plus `upgrade-insecure-requests`. Si vous
# ajoutez ou retirez un hôte dans src/config/medias.js, répercutez-le ici.

Options -Indexes
DirectoryIndex index.html

# Retire « Apache/2.4.x (Debian) Server at ... » du pied des pages d'erreur.
# `ServerTokens`, qui ferait de même sur l'en-tête `Server:`, ne s'écrit qu'en
# configuration serveur : sur un mutualisé il n'est pas à notre portée, et le
# placer ici renverrait une 500 sur tout le site.
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── 1. Forcer HTTPS ─────────────────────────────────────────────────────
  # Doit passer avant tout le reste. Les deux conditions couvrent les deux
  # façons dont OVH signale une connexion sécurisée selon la configuration.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ── 2. URL sans slash final ─────────────────────────────────────────────
  # Astro génère /contact/index.html et déclare le canonical /contact, sans
  # slash. Sans cette règle, mod_dir redirigerait /contact vers /contact/ : le
  # visiteur arriverait sur une adresse différente de celle annoncée à Google.
  # DirectorySlash Off désactive cette redirection, la règle sert le fichier.
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]
</IfModule>

# ── Verrou de bêta ──────────────────────────────────────────────────────────
# `robots.txt` demande poliment de ne pas explorer ; il n'empêche rien. Un robot
# qui l'ignore, ou un simple lien partagé vers la bêta, suffit à faire entrer
# l'adresse dans l'index — et le jour de l'ouverture, kanyro.fr publierait un
# contenu que Google connaît déjà sur un autre domaine.
#
# Un mot de passe, lui, ferme réellement la porte. À activer tant que
# `BETA.actif` vaut true dans src/config/site.js :
#
#   1. Espace client OVH → « Utilisateurs FTP & SSH » ou en SSH :
#        htpasswd -c ~/.htpasswd kanyro
#   2. Renseigner le chemin ABSOLU du fichier ci-dessous (OVH le donne dans
#      l'interface ; il ressemble à /homez.NNN/votrelogin/.htpasswd).
#   3. Décommenter les cinq lignes.
#
# ⚠ Placer .htpasswd HORS de www/, sinon il est téléchargeable.
#
# AuthType Basic
# AuthName "Kanyro — bêta"
# AuthUserFile /chemin/absolu/vers/.htpasswd
# Require valid-user

<IfModule mod_headers.c>
  # ── En-têtes de sécurité ─────────────────────────────────────────────────
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https://images.higgs.ai https://soft-zoom-63098134.figma.site; media-src 'self' https://d8j0ntlcm91z4.cloudfront.net; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Un site vitrine n'a besoin d'aucune de ces API. Les refuser toutes coûte
  # zéro en compatibilité et retire d'avance la surface à un script tiers qui
  # arriverait par un chemin que la CSP n'aurait pas vu venir.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), serial=(), bluetooth=(), display-capture=(), xr-spatial-tracking=()"

  # HSTS : à n'activer qu'une fois le certificat vérifié et le site accessible
  # en HTTPS sans erreur. Une fois envoyé, le navigateur refusera le HTTP
  # pendant un an, y compris si vous faites machine arrière.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Les fichiers de /_astro/ portent un hash dans leur nom : ils peuvent être
  # mis en cache indéfiniment sans risque de servir une version périmée.
  <FilesMatch "\.(css|js)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|avif|png|jpe?g|svg|woff2?)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>

  # Le HTML, lui, doit toujours être revalidé : c'est lui qui référence les
  # noms hashés des assets.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

AddDefaultCharset UTF-8
# Astro traite la page 404 à part : elle sort en /404.html à la racine, et non
# en /404/index.html comme les autres pages.
ErrorDocument 404 /404.html
