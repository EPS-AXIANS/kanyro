---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Showcase from '../components/sections/Showcase.astro';
import Offre from '../components/sections/Offre.astro';
import Realisation from '../components/sections/Realisation.astro';
import QuiSuisJe from '../components/sections/QuiSuisJe.astro';
import Processus from '../components/sections/Processus.astro';
import Suivi from '../components/sections/Suivi.astro';
import QandA from '../components/sections/QandA.astro';
import QuoteBanner from '../components/sections/QuoteBanner.astro';
import { agenceJsonLd, faqJsonLd } from '../config/schema.js';
import { offre } from '../data/offres.js';
import { questions } from '../data/questions.js';
import communes from '../data/communes.json';

/*
 * Vitrine volontairement courte : une seule page porte l'offre, le prix, la
 * preuve et l'appel à l'action. Tout ce qui viendrait s'ajouter avant le premier
 * client repousserait le moment de vendre.
 */
/*
 * Deux blocs de données structurées : l'agence (avec son offre et son
 * fondateur) et les questions de la page, lues dans le même fichier que la
 * section Q&R.
 */
const jsonLd = [agenceJsonLd(communes), faqJsonLd(questions)];

/*
 * Le titre et la description que Google affiche.
 *
 * Le titre portait « Sites internet pour artisans du bâtiment » : ni
 * « création », ni lieu, sur une page qui vend du référencement local. Il fait
 * 58 caractères avant la marque, pour que les mots utiles tiennent dans ce que
 * Google affiche. La description (151 caractères, sous la troncature) dit
 * l'offre, le prix et le délai, lus dans offres.js pour ne jamais diverger de la
 * page, et trois communes de la zone.
 */
const titre = 'Création de site internet pour artisans du bâtiment, Arras';
const description = `Site internet pour artisans du bâtiment, pensé pour recevoir des demandes de devis. De ${offre.prix}, en ligne en ${offre.delai}. Arras, Lens, Lille.`;
---

<Base titre={titre} description={description} jsonLd={jsonLd}>
  <Hero />
  <Showcase />
  <Offre />
  <Realisation />
  {/* Après la réalisation et avant le déroulement : on a vu le travail, on
      apprend qui l'a fait, puis comment ça se passe avec lui. */}
  <QuiSuisJe />
  {/* Placé après l'offre et avant les questions : on ne se demande « comment ça
      se passe ? » qu'une fois qu'on sait ce qu'on achète et combien ça coûte. */}
  <Processus />
  {/* Après le déroulement, jamais avant : « et ensuite ? » n'est une question
      qu'une fois qu'on sait ce qu'on achète et comment ça se passe. Posée plus
      haut, elle ajouterait un coût récurrent à une décision pas encore prise. */}
  <Suivi />
  <QandA />
  <QuoteBanner />
</Base>
