---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Visuel from '../../components/Visuel.astro';
import { FONCTIONS } from '../../config/site.js';
import { filAriane } from '../../config/schema.js';

/*
 * Route attrape-tout : voir l'explication dans metiers/[...page].astro. La
 * galerie reste hors ligne tant qu'aucun chantier n'est livré — une page
 * « réalisations » vide fait plus de mal que pas de page du tout.
 */
export function getStaticPaths() {
  if (!FONCTIONS.realisations) return [];
  return [{ params: { page: undefined } }];
}

const fiches = (await getCollection('realisations', ({ data }) => !data.brouillon)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const jsonLd = filAriane([
  { nom: 'Accueil', chemin: '/' },
  { nom: 'Réalisations', chemin: '/realisations' },
]);
---

{/*
  Le titre disait « Les chantiers livrés » et le sous-titre « avec les chiffres
  réels et la date à laquelle ils ont été mesurés », au-dessus d'une seule
  maquette, pas encore en ligne, sans aucun chiffre. Les deux phrases disent
  maintenant ce qu'il y a, et se mettent au pluriel d'elles-mêmes le jour où il
  y aura plus d'une fiche.
*/}
<Base
  titre="Réalisations, sites d'artisans"
  description="Les sites livrés par Kanyro, tels qu'ils sont : captures, point de départ, choix faits. Les chiffres s'ajoutent quand ils sont mesurés."
  jsonLd={jsonLd}
>
  <section class="contenu sous-navbar pb-16 text-center">
    <p class="surtitre reveal">Réalisations</p>
    <h1 class="titre-page reveal mt-6 [--retard:80ms]">
      {fiches.length > 1 ? 'Les sites livrés' : 'Le premier site livré'}
    </h1>
    <p
      class="font-texte reveal mx-auto mt-8 max-w-xl text-base leading-relaxed text-texte-doux [--retard:160ms]"
    >
      Montré tel qu'il est : captures, point de départ, choix faits. Les chiffres
      s'ajoutent quand ils sont mesurés, jamais avant.
    </p>
  </section>

  {
    fiches.length === 0 ? (
      /*
       * État vide assumé. Tant qu'aucun chantier n'est livré, il n'y a rien à
       * montrer — et inventer des références serait la pire façon de démarrer une
       * réputation dans un tissu local où tout le monde se connaît.
       */
      <section class="contenu pb-20">
        <div class="carte reveal mx-auto max-w-2xl bg-brique p-10 text-center">
          <h2 class="font-titre text-3xl tracking-wide sm:text-4xl">
            C'est nouveau, et ça se voit
          </h2>
          <p class="font-texte mt-6 text-sm leading-relaxed text-white/70">
            Je démarre. Plutôt que de remplir cette page de fausses références ou de
            maquettes présentées comme des chantiers, je préfère la laisser vide
            jusqu'au premier client livré.
          </p>
          <p class="font-texte mt-4 text-sm leading-relaxed text-white/70">
            En attendant, ça se traduit par un tarif de démarrage pour les premiers
            clients : vous prenez un risque sur quelqu'un qui n'a pas encore de
            références, c'est normal que ça se paie dans le prix.
          </p>
          <a href="/contact" class="bouton-primaire mt-9">En profiter</a>
        </div>
      </section>
    ) : (
      /*
       * Une seule colonne tant qu'il n'y a qu'une fiche : une carte seule dans
       * une grille à deux colonnes laissait la moitié droite vide, et la page
       * avait l'air inachevée. La vignette est la première capture
       * « ordinateur » de la fiche.
       */
      <section class="contenu pb-16">
        <ul class:list={['grid gap-6', fiches.length > 1 ? 'md:grid-cols-2' : 'mx-auto max-w-4xl']}>
          {fiches.map((f) => {
            const vignette = f.data.captures.find((c) => c.appareil === 'ordinateur');
            return (
            <li class="reveal">
              <a
                href={`/realisations/${f.id}`}
                class="carte flex h-full flex-col overflow-hidden no-underline transition-colors duration-500 hover:border-white/30 hover:bg-surface-haute"
              >
                {vignette && (
                  <Visuel
                    src={vignette.src}
                    alt={vignette.alt}
                    sizes="(min-width: 896px) 896px, 100vw"
                    largeurs={[480, 960, 1440]}
                    class="w-full border-b border-trait"
                  />
                )}
                <div class="flex flex-1 flex-col p-8">
                <p class="surtitre">
                  {f.data.metier} · {f.data.commune}
                </p>
                <h2 class="font-titre mt-4 text-3xl tracking-wide">
                  {f.data.titre}
                </h2>
                <p class="font-texte mt-3 flex-1 text-base leading-relaxed text-texte-doux">
                  {f.data.resume}
                </p>
                <span class="font-texte mt-6 text-sm font-semibold tracking-[0.15em] text-texte uppercase">
                  Lire la fiche <span aria-hidden="true">→</span>
                </span>

                {f.data.resultats.length > 0 && (
                  <dl class="mt-6 flex flex-wrap gap-8">
                    {f.data.resultats.map((r) => (
                      <div>
                        <dt class="font-texte text-[10px] tracking-[0.2em] text-texte-faible uppercase">
                          {r.libelle}
                        </dt>
                        <dd class="font-titre mt-1 text-2xl text-signal-vif">
                          {r.valeur}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                </div>
              </a>
            </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <Cta />
</Base>
