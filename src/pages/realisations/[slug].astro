---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { FONCTIONS } from '../../config/site.js';
import { filAriane } from '../../config/schema.js';

export async function getStaticPaths() {
  if (!FONCTIONS.realisations) return [];

  const fiches = await getCollection('realisations', ({ data }) => !data.brouillon);

  return fiches.map((fiche) => ({
    params: { slug: fiche.id },
    props: { fiche },
  }));
}

const { fiche } = Astro.props;
const { Content } = await render(fiche);

const jsonLd = filAriane([
  { nom: 'Accueil', chemin: '/' },
  { nom: 'Réalisations', chemin: '/realisations' },
  { nom: fiche.data.titre, chemin: `/realisations/${fiche.id}` },
]);

const dateLisible = fiche.data.date.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
});
---

<Base titre={fiche.data.titre} description={fiche.data.resume} jsonLd={jsonLd}>
  <nav
    class="contenu sous-navbar font-inter pb-6 text-[10px] tracking-[0.2em] text-texte-faible uppercase"
    aria-label="Fil d'Ariane"
  >
    <a href="/realisations" class="hover:text-texte">Réalisations</a>
    <span class="mx-2" aria-hidden="true">·</span>
    <span class="text-texte-doux">{fiche.data.client}</span>
  </nav>

  <article class="contenu max-w-3xl pb-20">
    <p class="surtitre reveal">{fiche.data.metier} · {fiche.data.commune}</p>
    <h1 class="titre-page reveal mt-6 [animation-delay:80ms]">{fiche.data.titre}</h1>
    <p
      class="font-inter reveal mt-6 text-sm leading-relaxed text-texte-doux [animation-delay:160ms]"
    >
      {fiche.data.resume}
    </p>

    <p class="font-inter reveal mt-5 text-xs text-texte-faible">
      {fiche.data.client} — mis en ligne en {dateLisible}
      {
        fiche.data.enLigne && (
          <>
            {' · '}
            <a class="text-signal-vif" href={fiche.data.enLigne} rel="noopener">
              voir le site
            </a>
          </>
        )
      }
    </p>

    {
      fiche.data.resultats.length > 0 && (
        <dl class="carte reveal mt-10 grid gap-8 bg-brique p-8 sm:grid-cols-2">
          {fiche.data.resultats.map((r) => (
            <div>
              <dt class="font-inter text-[10px] tracking-[0.2em] text-white/40 uppercase">
                {r.libelle}
              </dt>
              <dd class="font-arsenica mt-2 text-4xl text-signal-vif">{r.valeur}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="prose-kanyro reveal mt-14">
      <Content />
    </div>
  </article>

  <Cta />
</Base>

<style>
  /* Mise en forme du Markdown, sans plugin : le contenu reste simple. */
  .prose-kanyro :global(h2) {
    margin-top: 2.75rem;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    letter-spacing: 0.02em;
  }
  .prose-kanyro :global(h3) {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }
  .prose-kanyro :global(p) {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-texte-doux);
  }
  .prose-kanyro :global(ul) {
    margin-top: 1rem;
    list-style: disc;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-texte-doux);
  }
  .prose-kanyro :global(li) {
    margin-top: 0.5rem;
  }
  .prose-kanyro :global(strong) {
    color: var(--color-texte);
  }
  .prose-kanyro :global(img) {
    margin-top: 1.75rem;
    border-radius: 1rem;
  }
</style>
