---
import Base from '../layouts/Base.astro';
import Champ from '../components/Champ.astro';
import { CircleAlert } from 'lucide-astro';
import { SITE } from '../config/site.js';
import { filAriane } from '../config/schema.js';
import metiers from '../data/metiers.json';

const jsonLd = filAriane([
  { nom: 'Accueil', chemin: '/' },
  { nom: 'Contact', chemin: '/contact' },
]);

const classesBandeau = 'bandeau-alerte mb-8';
---

<Base
  titre="Demander un devis"
  description="Décrivez votre activité en quelques lignes. Réponse sous 48 h, avec un avis honnête sur ce qu'un site peut vous apporter."
  jsonLd={jsonLd}
>
  <section class="contenu sous-navbar grid gap-16 pb-24 lg:grid-cols-[1.25fr_1fr]">
    <div>
      <p class="surtitre reveal">Contact</p>
      <h1 class="titre-page reveal mt-6 [--retard:80ms]">
        Parlons de votre activité
      </h1>
      <p
        class="font-texte reveal mt-8 max-w-xl text-sm leading-relaxed text-texte-doux [--retard:160ms]"
      >
        Quelques lignes suffisent. Je réponds sous 48 heures, et je vous dis
        franchement si un site vous rapportera quelque chose.
      </p>

      <!--
        POST natif vers public/contact.php — aucun JavaScript nécessaire pour
        envoyer. Le script n'ajoute que le confort : restaurer la saisie après une
        erreur, afficher le bon bandeau, et signaler un champ fautif avant
        l'envoi plutôt qu'après. Sans lui, le formulaire fonctionne : les
        attributs `required` et `type="email"` rendent la main au navigateur.

        `bot-field` est le pot de miel : masqué en CSS, un humain ne le voit pas,
        un robot le remplit et l'envoi est ignoré côté serveur.
      -->
      <form
        name="devis"
        method="POST"
        action="/contact.php"
        class="reveal mt-12 max-w-xl [--retard:240ms]"
      >
        {/*
          Trois bandeaux, un par motif d'échec renvoyé par contact.php via
          ?erreur=. effets.js dévoile celui qui correspond et restaure la saisie.

          Un seul message générique serait plus simple, mais il dirait « le
          problème vient de mon côté » à quelqu'un qui a juste mal tapé son
          adresse : il chercherait la panne au lieu de corriger le champ.
        */}
        <p id="erreur-saisie" hidden role="alert" class={classesBandeau}>
          Il manque quelque chose, ou votre adresse email comporte une erreur.
          Vérifiez les champs signalés ci-dessous, ce que vous aviez écrit a été
          conservé.
          <CircleAlert class="bandeau-alerte-icone" stroke-width={1.5} aria-hidden="true" />
        </p>

        <p id="erreur-limite" hidden role="alert" class={classesBandeau}>
          Plusieurs demandes viennent de partir depuis votre connexion. Si ce
          n'était pas vous, ou si vous êtes pressé, écrivez-moi directement à{' '}
          <a class="text-signal-vif underline" href={`mailto:${SITE.contact.email}`}>
            {SITE.contact.email}
          </a>.
          <CircleAlert class="bandeau-alerte-icone" stroke-width={1.5} aria-hidden="true" />
        </p>

        <p id="erreur-envoi" hidden role="alert" class={classesBandeau}>
          Votre message n'est pas parti, le problème vient de mon côté, pas du
          vôtre. Écrivez-moi directement à{' '}
          <a class="text-signal-vif underline" href={`mailto:${SITE.contact.email}`}>
            {SITE.contact.email}
          </a>, je vous réponds aussi vite.
          <CircleAlert class="bandeau-alerte-icone" stroke-width={1.5} aria-hidden="true" />
        </p>

        <p class="hidden">
          <label>
            Ne remplissez pas ce champ : <input name="bot-field" tabindex="-1" />
          </label>
        </p>

        <div class="grid gap-6 sm:grid-cols-2">
          {/*
            `maxlength` reprend les garde-fous de contact.php (200 et 5000
            caractères). Empêcher la saisie coûte moins cher au visiteur que la
            refuser après coup — le serveur revalide de toute façon.
          */}
          <Champ
            id="nom"
            etiquette="Votre nom"
            requis
            message="Il me faut au moins un nom pour savoir à qui je réponds."
          >
            <input
              id="nom"
              name="nom"
              type="text"
              required
              maxlength="200"
              autocomplete="name"
              aria-describedby="nom-echec"
              class="champ-saisie"
            />
          </Champ>

          <Champ id="entreprise" etiquette="Votre entreprise">
            <input
              id="entreprise"
              name="entreprise"
              type="text"
              maxlength="200"
              autocomplete="organization"
              class="champ-saisie"
            />
          </Champ>

          <Champ
            id="email"
            etiquette="Votre email"
            requis
            message="Vérifiez cette adresse : c'est là que part ma réponse."
          >
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              aria-describedby="email-echec"
              class="champ-saisie"
            />
          </Champ>

          <Champ
            id="telephone"
            etiquette="Votre téléphone"
            message="Ce numéro semble incomplet — ou laissez-le vide, l'email suffit."
          >
            <input
              id="telephone"
              name="telephone"
              type="tel"
              autocomplete="tel"
              aria-describedby="telephone-echec"
              class="champ-saisie"
            />
          </Champ>
        </div>

        <div class="mt-6">
          <Champ id="metier" etiquette="Votre métier" variante="select">
            <select id="metier" name="metier" class="champ-saisie">
              <option value="">Choisir…</option>
              {metiers.map((m) => <option value={m.slug}>{m.nom}</option>)}
              <option value="autre">Autre métier du bâtiment</option>
            </select>
          </Champ>
        </div>

        {/* Pour ceux qui n'iront pas sur le calendrier — la majorité, sur cette
            cible. Évite au moins un aller-retour de mails. */}
        <div class="mt-6">
          <Champ id="disponibilite" etiquette="Quand vous joindre" variante="select">
            <select id="disponibilite" name="disponibilite" class="champ-saisie">
              <option value="">Peu importe, appelez quand vous pouvez</option>
              <option value="samedi-matin">Samedi matin</option>
              <option value="samedi-apres-midi">Samedi après-midi</option>
              <option value="soir-semaine">En soirée, en semaine</option>
              <option value="chantier">Passez me voir sur le chantier</option>
            </select>
          </Champ>
        </div>

        <div class="mt-6">
          <Champ
            id="message"
            etiquette="Où en êtes-vous aujourd'hui ?"
            requis
            variante="zone"
            message="Deux lignes suffisent : dites-moi simplement où vous en êtes."
          >
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              maxlength="5000"
              placeholder="Pas de site, un vieux site, des clients qui viennent surtout du bouche-à-oreille…"
              aria-describedby="message-echec"
              class="champ-saisie is--zone"></textarea>
          </Champ>
        </div>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
          <button type="submit" class="bouton-primaire w-full sm:w-auto">
            Envoyer ma demande
          </button>

          {
            /* Chemin secondaire, hors du <form> logiquement mais placé à côté du
               bouton parce que c'est là qu'on hésite. Lien sortant : aucun
               script tiers, aucun cookie, CSP inchangée. */
            SITE.rendezVous.url && (
              <a
                href={SITE.rendezVous.url}
                target="_blank"
                rel="noopener"
                class="bouton-secondaire w-full text-center sm:w-auto"
              >
                {SITE.rendezVous.libelle}
              </a>
            )
          }
        </div>

        {
          SITE.rendezVous.url && (
            <p class="font-texte mt-4 text-xs text-texte-faible">
              Le calendrier n'affiche que des créneaux réellement ouverts —{' '}
              {SITE.rendezVous.duree}, par téléphone ou sur votre chantier.
            </p>
          )
        }

        <p class="font-texte mt-5 text-xs text-texte-faible">
          Vos coordonnées servent uniquement à vous répondre. Elles ne sont ni
          revendues, ni utilisées pour de la prospection.
        </p>
      </form>
    </div>

    <aside class="reveal lg:pt-32">
      <div class="carte bg-brique p-8">
        <h2 class="font-titre text-2xl tracking-wide">Écrire directement</h2>
        <p class="mt-4">
          <a
            href={`mailto:${SITE.contact.email}`}
            class="font-texte text-sm break-all text-signal-vif hover:text-texte"
          >
            {SITE.contact.email}
          </a>
        </p>

        {
          SITE.contact.telephoneAffiche && (
            <p class="mt-4">
              <a
                href={`tel:${SITE.contact.telephone}`}
                class="font-texte text-sm text-signal-vif hover:text-texte"
              >
                {SITE.contact.telephoneAffiche}
              </a>
            </p>
          )
        }

        <hr class="my-8 border-white/15" />

        <h2 class="font-titre text-2xl tracking-wide">Quand je suis joignable</h2>
        <p class="font-texte mt-4 text-xs leading-relaxed text-white/60">
          Le samedi matin, à coup sûr. Et certains soirs en semaine, mais pas tous :
          je suis en alternance, donc je termine à 16 h une semaine et à 22 h la
          suivante.
        </p>
        <p class="font-texte mt-3 text-xs leading-relaxed text-white/60">
          {
            SITE.rendezVous.url
              ? 'Plutôt que de vous faire deviner, le calendrier n’affiche que les créneaux réellement ouverts.'
              : 'Dites-moi simplement quand vous joindre dans le formulaire, je m’adapte.'
          }
        </p>

        <hr class="my-8 border-white/15" />

        <h2 class="font-titre text-2xl tracking-wide">Le secteur</h2>
        <p class="font-texte mt-4 text-xs leading-relaxed text-white/60">
          L'Arrageois, le bassin minier et la métropole lilloise. Je me déplace sur
          vos chantiers, c'est là que se prennent les photos qui font signer.
        </p>
      </div>
    </aside>
  </section>
</Base>
