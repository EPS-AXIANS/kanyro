---
import LienTelephone from './LienTelephone.astro';

const {
  titre = 'On en parle vingt minutes ?',
  texte = "Vous décrivez votre activité et vos chantiers, je vous dis franchement si un site vous rapportera quelque chose. Si la réponse est non, je vous le dirai.",
  libelle = 'Demander un devis',
  href = '/contact',
} = Astro.props;

/*
 * L'échange de lettres au survol est réservé au « Demander un devis ». Le
 * libellé étant une prop, la décision se prend ici plutôt que dans les pages
 * qui posent ce bloc — dont aucune, aujourd'hui, ne le remplace.
 *
 * ⚠ `undefined` ET NON `false`. Astro écrit `data-bouton-anime="false"` pour un
 * attribut de données faux, et le sélecteur `[data-bouton-anime]` l'attraperait
 * quand même : l'effet se jouerait précisément sur les boutons censés y avoir
 * renoncé. Même piège que `data-optionnel` dans Champ.astro.
 *
 * Et chaîne vide plutôt que `true`, qui ferait écrire `data-bouton-anime="true"`
 * — sans conséquence pour le sélecteur, mais la valeur laisserait croire qu'elle
 * est lue. C'est la forme que pose déjà `bouton.dataset.boutonDecoupe = ''`.
 *
 * Le téléphone accompagne toujours le devis : sur les pages internes comme sur
 * l'accueil, l'appel est l'autre chemin naturel d'un artisan.
 */
const anime = libelle === 'Demander un devis' ? '' : undefined;
---

<section class="contenu py-24">
  <div
    class="reveal relative overflow-hidden rounded-3xl bg-brique px-6 py-16 text-center sm:px-12 sm:py-20"
  >
    <h2 class="font-titre mx-auto max-w-2xl text-3xl tracking-wide sm:text-4xl md:text-5xl">
      {titre}
    </h2>
    <p class="font-texte mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/80">
      {texte}
    </p>
    <div class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
      <a href={href} data-bouton-anime={anime} data-mesure="devis" class="bouton-primaire">{libelle}</a>
      <LienTelephone class="bouton-secondaire inline-flex items-center justify-center gap-2.5 tracking-[0.12em]" />
    </div>
  </div>
</section>
