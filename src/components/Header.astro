---
import { SITE } from '../config/site.js';

/*
 * Barre flottante centrée, en liquid glass.
 *
 * Le site tient en une page tant qu'il n'y a pas de premier client : les quatre
 * entrées pointent donc vers des ancres de l'accueil, sauf Contact. Elles sont
 * préfixées par « / » pour rester valides depuis les pages internes.
 *
 * Les tailles et l'interlettrage sont resserrés sous 640 px pour que les quatre
 * libellés tiennent sur une ligne sans faire déborder la pastille.
 */
const gauche = [
  { texte: 'Offre', href: '/#offre' },
  { texte: 'Questions', href: '/#questions' },
];

const droite = [
  { texte: 'Preuve', href: '/#preuve' },
  { texte: 'Contact', href: '/contact' },
];

const actuel = Astro.url.pathname.replace(/\.html$/, '');

const classeLien =
  'whitespace-nowrap text-[9px] sm:text-xs font-medium uppercase tracking-[0.1em] sm:tracking-[0.2em] no-underline transition-colors duration-300';
---

<header
  class="fixed top-4 left-1/2 z-50 -translate-x-1/2 sm:top-6"
  aria-label="Navigation principale"
>
  <nav
    class="verre flex items-center gap-3 rounded-full border border-white/15 px-4 py-2.5 sm:gap-12 sm:px-10 sm:py-3"
  >
    {
      gauche.map((l) => (
        <a href={l.href} class:list={[classeLien, 'text-white/85 hover:text-white']}>
          {l.texte}
        </a>
      ))
    }

    <a href="/" aria-label={`${SITE.nom} — accueil`} class="shrink-0">
      <svg
        viewBox="0 0 256 256"
        class="h-5 w-5 transition-transform duration-300 hover:scale-110 sm:h-7 sm:w-7"
        fill="white"
        aria-hidden="true"
      >
        <path
          d="M 64 128 L 64.5 128 L 32 95 L 0 64 L 0 0 L 64 0 L 128 64 L 128 64.5 L 161 32 L 192 0 L 256 0 L 256 64 L 192 128 L 128 128 L 128 192 L 96 223 L 63.5 256 L 0 256 L 0 192 Z M 256 192 L 224 223 L 191.5 256 L 128 256 L 128 192 L 192 128 L 256 128 Z"
        />
      </svg>
    </a>

    {
      droite.map((l) => (
        <a
          href={l.href}
          aria-current={actuel === l.href ? 'page' : undefined}
          class:list={[
            classeLien,
            actuel === l.href ? 'text-white' : 'text-white/85 hover:text-white',
          ]}
        >
          {l.texte}
        </a>
      ))
    }
  </nav>
</header>
