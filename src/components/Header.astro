---
import { SITE } from '../config/site.js';

/*
 * Barre flottante centrée, en liquid glass.
 *
 * Les entrées pointent vers des ancres de l'accueil, sauf Contact. Elles sont
 * préfixées par « / » pour rester valides depuis les pages internes.
 *
 * ---- Lisibilité et cibles ----
 *
 * Les libellés étaient en 9 px sous 640 px, et chaque lien faisait 15 px de
 * haut. Ils passent à 11 px (le plus que permettent quatre libellés sur une
 * ligne à 360 px de large, avec « Réalisation »), et chaque lien reçoit une
 * hauteur minimale de 44 px : la pastille grandit un peu, la cible du pouce
 * devient réelle.
 *
 * ---- Repères ----
 *
 * `aria-label` est sur le <nav> et plus sur le <header> : c'est la navigation
 * qu'un lecteur d'écran liste parmi les repères, et le pied de page en a une
 * seconde (« Pied de page »), qu'il faut pouvoir distinguer.
 */
const gauche = [
  { texte: 'Offre', href: '/#offre' },
  { texte: 'Questions', href: '/#questions' },
];

const droite = [
  { texte: 'Réalisation', href: '/#realisation' },
  { texte: 'Contact', href: '/contact' },
];

const actuel = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

const classeLien =
  'inline-flex min-h-11 items-center whitespace-nowrap px-1 text-[11px] sm:text-xs font-medium uppercase tracking-[0.06em] sm:tracking-[0.2em] no-underline transition-colors duration-300';
---

<header class="fixed top-3 left-1/2 z-50 -translate-x-1/2 sm:top-6">
  {/*
    `data-barre` est la prise de effets.js, `barre` porte l'état dense.

    ⚠ L'état LISIBLE est celui du CSS, et le script ne fait que l'éclaircir sur
    le premier écran — jamais l'inverse. Le détail et la raison sont dans
    global.css, section « barre de navigation ».
  */}
  <nav
    data-barre
    aria-label="Navigation principale"
    class="liquid-glass barre flex items-center gap-1.5 rounded-full px-3 sm:gap-10 sm:px-8"
  >
    {
      gauche.map((l) => (
        <a
          href={l.href}
          class:list={[classeLien, 'text-white/90 hover:text-white']}
        >
          {l.texte}
        </a>
      ))
    }

    <a
      href="/"
      aria-label={`${SITE.nom}, retour à l'accueil`}
      class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center"
    >
      <svg
        viewBox="0 0 256 256"
        class="h-5 w-5 transition-transform duration-300 hover:scale-110 sm:h-7 sm:w-7"
        fill="white"
        aria-hidden="true"
      >
        <path
          d="M 64 128 L 64.5 128 L 32 95 L 0 64 L 0 0 L 64 0 L 128 64 L 128 64.5 L 161 32 L 192 0 L 256 0 L 256 64 L 192 128 L 128 128 L 128 192 L 96 223 L 63.5 256 L 0 256 L 0 192 Z M 256 192 L 224 223 L 191.5 256 L 128 256 L 128 192 L 192 128 L 256 128 Z"
        />
      </svg>
    </a>

    {
      droite.map((l) => (
        <a
          href={l.href}
          aria-current={actuel === l.href ? 'page' : undefined}
          class:list={[
            classeLien,
            actuel === l.href ? 'text-white' : 'text-white/90 hover:text-white',
          ]}
        >
          {l.texte}
        </a>
      ))
    }
  </nav>
</header>
