---
import { Facebook, Instagram, Linkedin, Mail, Aperture } from 'lucide-astro';
import { FONCTIONS, SITE, reseauxActifs } from '../config/site.js';

const { variante = 'standard' } = Astro.props;

/*
 * Les icônes de réseaux ne sont rendues que pour une vraie adresse : le filtre
 * est `reseauxActifs()`, partagé avec le JSON-LD. Un lien social mort sur le
 * site d'une agence, c'est un mauvais signal envoyé au premier prospect qui
 * clique — mieux vaut l'absence que le vide.
 */
const ICONES = {
  linkedin: { Icone: Linkedin, nom: 'LinkedIn' },
  instagram: { Icone: Instagram, nom: 'Instagram' },
  facebook: { Icone: Facebook, nom: 'Facebook' },
};
const reseaux = reseauxActifs()
  .filter((r) => ICONES[r.nom])
  .map((r) => ({ url: r.url, ...ICONES[r.nom] }));

const classeTexte =
  'text-[9px] sm:text-[10px] font-medium uppercase tracking-[0.15em] sm:tracking-[0.25em] text-white/90 transition-colors hover:text-white no-underline';
const classeIcone = 'text-white/90 transition-colors hover:text-white';
const annee = new Date().getFullYear();
---

{
  /* Pages internes : bloc de liens complet avant la barre. La page d'accueil
     s'en passe, ses sections tiennent le plein écran. */
  variante === 'standard' && (
    <footer class="border-t border-trait bg-fond">
      <div class="contenu grid gap-10 py-16 md:grid-cols-3">
        <div>
          <p class="font-titre text-2xl tracking-wide">{SITE.nom}</p>
          <p class="mt-3 max-w-xs text-sm text-white/60">{SITE.baseline}</p>
          <p class="mt-4 text-sm text-white/40">
            {SITE.zone.ville} · {SITE.zone.region}. Je me déplace sur vos chantiers.
          </p>
        </div>

        <nav aria-label="Liens de pied de page">
          <p class="text-[10px] font-medium tracking-[0.25em] text-white/40 uppercase">
            Le site
          </p>
          <ul class="mt-4 space-y-2.5 text-sm text-white/70">
            <li><a class="hover:text-white" href="/#offre">L'offre</a></li>
            <li><a class="hover:text-white" href="/#questions">Questions</a></li>
            {/* Le lien n'existe que si la section est générée. */}
            {FONCTIONS.realisations && (
              <li><a class="hover:text-white" href="/realisations">Réalisations</a></li>
            )}
            <li><a class="hover:text-white" href="/contact">Contact</a></li>
            <li>
              <a class="hover:text-white" href="/mentions-legales">
                Mentions légales
              </a>
            </li>
          </ul>
        </nav>

        <div>
          <p class="text-[10px] font-medium tracking-[0.25em] text-white/40 uppercase">
            Écrire
          </p>
          <a
            href={`mailto:${SITE.contact.email}`}
            class="mt-4 inline-block text-sm break-all text-white/70 hover:text-white"
          >
            {SITE.contact.email}
          </a>
          {SITE.contact.telephoneAffiche && (
            <p class="mt-3">
              <a
                href={`tel:${SITE.contact.telephone}`}
                class="text-sm text-white/70 hover:text-white"
              >
                {SITE.contact.telephoneAffiche}
              </a>
            </p>
          )}
          <p class="mt-6 text-xs text-white/30">© {annee} {SITE.nom}</p>
        </div>
      </div>
    </footer>
  )
}

{/*
  ---- Le dégradé n'est pas décoratif, il porte la lisibilité ----

  Cette barre passe devant TOUS les fonds de l'accueil, et l'un d'eux est clair :
  le ciel de la citation. Le dégradé valait `from-black/40`, ce qui laisse au
  niveau du texte un fond composite d'environ 0,36 de luminance ; du blanc à
  80 % par-dessus donne un contraste de 2,2:1, là où 4,5:1 sont exigés pour du
  texte de neuf pixels. Autrement dit, une mention légale illisible sur le
  dernier écran du site.

  Même parti que pour la barre de navigation : c'est l'état LISIBLE qui devient
  le défaut, plutôt qu'une correction conditionnelle qui dépendrait d'un script.

  ---- Pourquoi plus HAUT plutôt que plus SOMBRE ----

  Assombrir le dégradé sur sa hauteur actuelle — une cinquantaine de pixels —
  aurait posé une bande franche en bas de l'écran, bien visible sur le brun de
  l'offre et des questions. Le `pt-20` étire la même course sur 128 px : la
  valeur sous le texte monte à 0,71 d'opacité, ce qui donne 5,3:1, et la sortie
  se fait sur 90 px, donc sans arête. Sur les fonds sombres, l'ensemble se lit
  comme un vignettage de bas de cadre, pas comme un bandeau.

  ⚠ `pointer-events-none` sur le conteneur, `auto` sur la rangée. Les 80 px de
  rembourrage sont un calque transparent en travers du bas de l'écran : sans
  ça, il avalerait tous les clics qui tombent dedans. Le navigateur teste la
  boîte, pas les pixels peints — c'est la même règle qui avait fait perdre les
  clics du bouton du hero.

  ⚠ Le rembourrage ne vaut QUE pour la variante cinéma. En `sticky`, la barre
  est dans le flux et ces 80 px ajouteraient un vide en pied de chaque page
  interne — pages dont le fond est de toute façon uniformément sombre, donc sans
  problème de lisibilité à régler.
*/}
<div
  class:list={[
    'pointer-events-none right-0 bottom-0 left-0 z-40 bg-gradient-to-t',
    variante === 'cinema'
      ? 'fixed from-black/90 via-black/40 to-transparent pt-20'
      : 'sticky from-black/60 to-transparent',
  ]}
>
  <div
    class="pointer-events-auto flex items-center justify-between px-3 py-2.5 sm:px-10 sm:py-4"
  >
    <div class="flex items-center gap-4 sm:gap-6">
      {
        reseaux.map(({ url, Icone, nom }) => (
          <a href={url} rel="me noopener" aria-label={nom} class={classeIcone}>
            <Icone class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
          </a>
        ))
      }
      <a
        href={`mailto:${SITE.contact.email}`}
        aria-label="Écrire un email"
        class={classeIcone}
      >
        <Mail class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
      </a>
      <a href="/mentions-legales" class:list={[classeTexte, 'hidden sm:inline']}>
        Mentions légales
      </a>
    </div>

    <div class="flex items-center gap-4 sm:gap-6">
      <a href="/#offre" class:list={[classeTexte, 'hidden sm:inline']}>
        Offre & tarif
      </a>
      <a href="/contact" aria-label="Demander un devis" class={classeIcone}>
        <Aperture class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</div>
