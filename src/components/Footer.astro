---
import { Facebook, Instagram, Linkedin, Mail, Aperture } from 'lucide-astro';
import { SITE } from '../config/site.js';

const { variante = 'standard' } = Astro.props;

/*
 * Les icônes de réseaux ne sont rendues que si l'URL est renseignée dans
 * site.js. Un lien social mort sur le site d'une agence, c'est un mauvais signal
 * envoyé au premier prospect qui clique — mieux vaut l'absence que le vide.
 */
const reseaux = [
  { url: SITE.reseaux.linkedin, Icone: Linkedin, nom: 'LinkedIn' },
  { url: SITE.reseaux.instagram, Icone: Instagram, nom: 'Instagram' },
  { url: SITE.reseaux.facebook, Icone: Facebook, nom: 'Facebook' },
].filter((r) => r.url);

const classeTexte =
  'text-[9px] sm:text-[10px] font-medium uppercase tracking-[0.15em] sm:tracking-[0.25em] text-white/80 transition-colors hover:text-white no-underline';
const classeIcone = 'text-white/80 transition-colors hover:text-white';
const annee = new Date().getFullYear();
---

{
  /* Pages internes : bloc de liens complet avant la barre. La page d'accueil
     s'en passe, ses sections tiennent le plein écran. */
  variante === 'standard' && (
    <footer class="border-t border-trait bg-fond">
      <div class="contenu grid gap-10 py-16 md:grid-cols-3">
        <div>
          <p class="font-arsenica text-2xl tracking-wide">{SITE.nom}</p>
          <p class="mt-3 max-w-xs text-sm text-white/60">{SITE.baseline}</p>
          <p class="mt-4 text-sm text-white/40">
            {SITE.zone.ville} · {SITE.zone.region} — déplacement sur vos chantiers.
          </p>
        </div>

        <nav aria-label="Liens de pied de page">
          <p class="text-[10px] font-medium tracking-[0.25em] text-white/40 uppercase">
            Le site
          </p>
          <ul class="mt-4 space-y-2.5 text-sm text-white/70">
            <li><a class="hover:text-white" href="/#offre">L'offre</a></li>
            <li><a class="hover:text-white" href="/#questions">Questions</a></li>
            <li><a class="hover:text-white" href="/contact">Contact</a></li>
            <li>
              <a class="hover:text-white" href="/mentions-legales">
                Mentions légales
              </a>
            </li>
          </ul>
        </nav>

        <div>
          <p class="text-[10px] font-medium tracking-[0.25em] text-white/40 uppercase">
            Écrire
          </p>
          <a
            href={`mailto:${SITE.contact.email}`}
            class="mt-4 inline-block text-sm break-all text-white/70 hover:text-white"
          >
            {SITE.contact.email}
          </a>
          {SITE.contact.telephoneAffiche && (
            <p class="mt-3">
              <a
                href={`tel:${SITE.contact.telephone}`}
                class="text-sm text-white/70 hover:text-white"
              >
                {SITE.contact.telephoneAffiche}
              </a>
            </p>
          )}
          <p class="mt-6 text-xs text-white/30">© {annee} {SITE.nom}</p>
        </div>
      </div>
    </footer>
  )
}

<div
  class:list={[
    'right-0 bottom-0 left-0 z-40 bg-gradient-to-t from-black/40 to-transparent',
    variante === 'cinema' ? 'fixed' : 'sticky',
  ]}
>
  <div class="flex items-center justify-between px-3 py-2.5 sm:px-10 sm:py-4">
    <div class="flex items-center gap-4 sm:gap-6">
      {
        reseaux.map(({ url, Icone, nom }) => (
          <a href={url} rel="me noopener" aria-label={nom} class={classeIcone}>
            <Icone class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
          </a>
        ))
      }
      <a
        href={`mailto:${SITE.contact.email}`}
        aria-label="Écrire un email"
        class={classeIcone}
      >
        <Mail class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
      </a>
      <a href="/mentions-legales" class:list={[classeTexte, 'hidden sm:inline']}>
        Mentions légales
      </a>
    </div>

    <div class="flex items-center gap-4 sm:gap-6">
      <a href="/#offre" class:list={[classeTexte, 'hidden sm:inline']}>
        Offre & tarif
      </a>
      <a href="/contact" aria-label="Demander un devis" class={classeIcone}>
        <Aperture class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</div>
