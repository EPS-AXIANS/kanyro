---
import { Facebook, Instagram, Linkedin, Mail } from 'lucide-astro';
import { FONCTIONS, SITE, reseauxActifs } from '../config/site.js';
import LienTelephone from './LienTelephone.astro';

/*
 * Le même pied de page sur toutes les pages, accueil compris.
 *
 * L'accueil n'avait jusqu'ici qu'une barre fixe d'icônes, sans téléphone, avec
 * deux réseaux morts et un lien « Mentions légales » masqué sur mobile : la
 * page se terminait sur une citation, sans rien après. Les mentions légales
 * doivent être accessibles depuis chaque page (LCEN), le téléphone aussi, et un
 * artisan qui arrive en bas de page cherche précisément ces deux choses.
 *
 * Les icônes de réseaux ne sont rendues que pour une vraie adresse : le filtre
 * est `reseauxActifs()`, partagé avec le JSON-LD.
 */
const ICONES = {
  linkedin: { Icone: Linkedin, nom: 'LinkedIn' },
  instagram: { Icone: Instagram, nom: 'Instagram' },
  facebook: { Icone: Facebook, nom: 'Facebook' },
};
const reseaux = reseauxActifs()
  .filter((r) => ICONES[r.nom])
  .map((r) => ({ url: r.url, ...ICONES[r.nom] }));

const annee = new Date().getFullYear();

const classeLien =
  'inline-flex min-h-11 items-center text-[0.9375rem] text-texte-doux no-underline transition-colors hover:text-texte';
---

<footer class="border-t border-trait bg-fond">
  <div class="contenu grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr] md:gap-12 md:py-16">
    <div>
      <p class="font-titre text-3xl tracking-wide">{SITE.nom}</p>
      <p class="font-texte mt-3 max-w-xs text-[0.9375rem] leading-relaxed text-texte-doux">
        {SITE.baseline}
      </p>
      <p class="font-texte mt-4 max-w-xs text-sm leading-relaxed text-texte-faible">
        {SITE.zone.libelle}. Je me déplace sur vos chantiers.
      </p>
    </div>

    <nav aria-label="Pied de page">
      <p class="surtitre">Le site</p>
      <ul class="font-texte mt-3 grid grid-cols-2 gap-x-6 md:grid-cols-1">
        <li><a class={classeLien} href="/#offre">L'offre et les prix</a></li>
        {FONCTIONS.realisations && (
          <li><a class={classeLien} href="/realisations">Réalisation</a></li>
        )}
        {FONCTIONS.pagesMetiers && (
          <li><a class={classeLien} href="/metiers">Les métiers</a></li>
        )}
        <li><a class={classeLien} href="/#questions">Vos questions</a></li>
        <li><a class={classeLien} href="/contact">Demander un devis</a></li>
        <li><a class={classeLien} href="/mentions-legales">Mentions légales</a></li>
      </ul>
    </nav>

    <div>
      <p class="surtitre">Me joindre</p>
      <ul class="font-texte mt-3">
        <li>
          <LienTelephone class={`${classeLien} gap-2.5 text-texte`} />
        </li>
        <li>
          <a
            href={`mailto:${SITE.contact.email}`}
            class={`${classeLien} gap-2.5 break-all`}
          >
            <Mail class="h-4 w-4 shrink-0" stroke-width={1.5} aria-hidden="true" />
            {SITE.contact.email}
          </a>
        </li>
        {reseaux.map(({ url, Icone, nom }) => (
          <li>
            <a href={url} rel="me noopener" class={`${classeLien} gap-2.5`}>
              <Icone class="h-4 w-4 shrink-0" stroke-width={1.5} aria-hidden="true" />
              {nom}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="contenu border-t border-trait py-3">
    <p class="font-texte flex flex-wrap items-center gap-x-2 text-sm text-texte-faible">
      <span>© {annee} {SITE.nom}</span>
      <span aria-hidden="true">·</span>
      <a
        href="/mentions-legales"
        class="inline-flex min-h-11 items-center text-texte-faible underline-offset-4 hover:text-texte"
      >
        Mentions légales
      </a>
    </p>
  </div>
</footer>
