---
import { offreMensuelle } from '../../data/offres.js';

/*
 * Le forfait Suivi, en vitrine.
 *
 * ---- Pourquoi cette section existe, alors qu'un second prix est un risque ----
 *
 * Le point 2.2 de la tasklist est formel : deux tarifs sur la même page sans
 * règle qui les relie, et le prospect n'en retient qu'une chose — que le prix
 * se négocie. C'est ce qui avait fait garder le forfait hors de la vitrine.
 *
 * La parade retenue n'est pas de le cacher, c'est d'écrire la règle. Elle tient
 * en deux endroits, et les deux comptent :
 *
 *   1. Sous le prix du site, dans Offre.astro, une ligne annonce ce forfait et
 *      pointe ici — de la même façon que le prix normal annonce le tarif de
 *      lancement. Un prix qu'on découvre plus bas sans y avoir été préparé se
 *      lit comme un supplément caché.
 *   2. Ici, `demarrage` dit que la première année est déjà payée. Les deux
 *      montants ne sont donc jamais en concurrence : ils ne portent pas sur la
 *      même période. C'est ça, la règle qui les relie.
 *
 * ---- Pourquoi l'alternative à ~30 €/an est affichée ----
 *
 * Elle est le meilleur argument dont on dispose, et la taire serait le pire
 * calcul. Un artisan qui découvre seul qu'il pouvait s'héberger pour trente
 * euros ne se dit pas qu'il a mal lu : il se dit qu'on lui a caché quelque
 * chose. Affichée, elle transforme le forfait en choix — et quelqu'un qui a le
 * choix et qui reste, reste.
 *
 * ---- Ce que la mise en forme doit dire ----
 *
 * Fond `surface` et non `brique`. La brique est la couleur de l'offre
 * principale ; la reprendre ici mettrait les deux offres au même rang, alors
 * que celle-ci est facultative et ne démarre que dans un an. Le fond plus
 * sombre la pose comme une suite, pas comme une seconde porte d'entrée.
 *
 * Les chiffres sont en Cormorant Light, comme le prix du site. La tentation
 * était grande de passer un abonnement en sans-serif grasse — c'est le registre
 * des grilles tarifaires SaaS, et c'est exactement ce que la note de Offre.astro
 * interdit. Un abonnement facturé comme un artisan doit s'afficher comme tel.
 */

/*
 * Littéraux, jamais assemblés : Tailwind lit les sources comme du texte et ne
 * génèrerait pas une classe construite à l'exécution.
 */
const delais = [
  '[animation-delay:80ms]',
  '[animation-delay:160ms]',
  '[animation-delay:240ms]',
  '[animation-delay:320ms]',
  '[animation-delay:400ms]',
];
---

{
  offreMensuelle.actif && (
    <section id="suivi" class="bg-surface px-4 py-24 sm:px-8 md:px-16 lg:px-28 lg:py-32">
      <div class="mx-auto max-w-5xl">
        <p class="surtitre reveal text-center">Une fois le site en ligne</p>
        <h2
          class="font-titre reveal mx-auto mt-6 max-w-3xl text-center text-4xl tracking-wide sm:text-5xl md:text-6xl"
        >
          Le forfait {offreMensuelle.nom}
        </h2>
        <p
          class="font-texte reveal mx-auto mt-7 max-w-xl text-center text-sm leading-relaxed text-texte-doux [animation-delay:120ms] sm:text-base"
        >
          {offreMensuelle.promesse}
        </p>

        {/* Les deux montants côte à côte, comme le prix et le délai de l'offre
            principale : ce sont les deux seules questions posées ici. */}
        <div class="reveal mt-12 flex flex-col items-center gap-8 sm:flex-row sm:justify-center sm:gap-16">
          <div class="text-center">
            <p class="font-texte text-[10px] tracking-[0.25em] text-texte-faible uppercase">
              Au mois
            </p>
            <p class="font-titre mt-2 text-4xl font-light tracking-[0.01em] sm:text-5xl">
              {offreMensuelle.prix}
            </p>
            <p class="font-texte mt-2 text-xs text-texte-faible">sans engagement de durée</p>
          </div>

          <div class="pointer-events-none hidden h-16 w-px bg-white/15 sm:block" aria-hidden="true" />

          <div class="text-center">
            <p class="font-texte text-[10px] tracking-[0.25em] text-texte-faible uppercase">
              Ou à l'année
            </p>
            <p class="font-titre mt-2 text-4xl font-light tracking-[0.01em] sm:text-5xl">
              {offreMensuelle.prixAnnuel}
            </p>
            <p class="font-texte mt-2 text-xs text-signal-vif">{offreMensuelle.mentionAnnuel}</p>
          </div>
        </div>

        {/* La phrase qui empêche les deux prix de la page de se concurrencer.
            Elle est encadrée parce qu'elle doit être lue, pas parcourue : c'est
            elle qui répond au « donc le site coûte 2 900 € PLUS 25 € par mois ? »
            qui se pose sinon en silence, et qu'on n'entendra jamais poser. */}
        <p
          class="carte font-texte reveal mx-auto mt-12 max-w-2xl p-6 text-center text-sm leading-relaxed text-texte-doux"
        >
          Rien à régler aujourd'hui, et rien à signer. Le forfait démarre{' '}
          {offreMensuelle.demarrage}, et seulement si vous le décidez à ce
          moment-là.
        </p>

        <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-2">
          {offreMensuelle.inclus.map((bloc, i) => (
            <li class:list={['reveal bg-surface-haute p-8', delais[i]]}>
              <h3 class="font-titre text-[1.75rem] leading-snug tracking-wide">{bloc.titre}</h3>
              <p class="font-texte mt-3 text-sm leading-relaxed text-texte-doux">{bloc.detail}</p>
            </li>
          ))}
        </ul>

        <div class="mt-16 grid gap-12 md:grid-cols-2">
          <div>
            <h3 class="font-titre reveal text-[1.75rem] tracking-wide">Ce sur quoi je m'engage</h3>
            {/* En orange, et seuls de la section à l'être. C'est ce qui sépare
                ce forfait d'une revente d'hébergement avec marge : le reste,
                n'importe quel hébergeur le fait pour trente euros par an. */}
            <ul class="mt-5 space-y-3">
              {offreMensuelle.engagement.map((e) => (
                <li class="font-texte reveal flex gap-3 text-sm text-texte-doux">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-signal-vif" />
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="font-titre reveal text-[1.75rem] tracking-wide">Ce qui n'est pas compris</h3>
            <ul class="mt-5 space-y-3">
              {offreMensuelle.horsPerimetre.map((h) => (
                <li class="font-texte reveal flex gap-3 text-sm text-texte-faible">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/25" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="reveal mt-16 border-t border-trait pt-10">
          <p class="font-texte mx-auto max-w-2xl text-center text-sm leading-relaxed text-texte-doux">
            {offreMensuelle.sortie}
          </p>
          <p class="font-texte mx-auto mt-4 max-w-2xl text-center text-xs leading-relaxed text-texte-faible">
            Et si vous préférez ne rien prendre, comptez{' '}
            {offreMensuelle.alternative}. Le site continue de tourner, il est à
            vous.
          </p>
        </div>
      </div>
    </section>
  )
}
