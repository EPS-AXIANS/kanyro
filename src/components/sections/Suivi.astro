---
import { ChevronDown } from 'lucide-astro';
import { offreMensuelle } from '../../data/offres.js';
import { mentionTva } from '../../config/site.js';

/*
 * Le suivi, en vitrine : Kanyro Maintenance et Kanyro Accompagnement.
 *
 * ---- Pourquoi cette section existe, alors qu'un second prix est un risque ----
 *
 * Le point 2.2 de la tasklist est formel : deux tarifs sur la même page sans
 * règle qui les relie, et le prospect n'en retient qu'une chose — que le prix
 * se négocie. La parade retenue n'est pas de le cacher, c'est d'écrire la
 * règle, à deux endroits : sous le prix du site (Offre.astro), et ici, où
 * `demarrage` dit que la première année est déjà payée. Les montants ne
 * portent donc jamais sur la même période.
 *
 * ---- Pourquoi l'alternative à ~30 €/an est affichée ----
 *
 * Elle est le meilleur argument dont on dispose, et la taire serait le pire
 * calcul. Un artisan qui découvre seul qu'il pouvait s'héberger pour trente
 * euros ne se dit pas qu'il a mal lu : il se dit qu'on lui a caché quelque
 * chose. Affichée, elle transforme le forfait en choix.
 *
 * ---- Un résumé, et le tableau replié ----
 *
 * Le tableau comparatif occupait 2 950 px sur un téléphone, onze lignes de
 * 130 px sous un en-tête collant qui prenait le quart de l'écran, pour une
 * décision qui ne se prend qu'au onzième mois. Deux cartes disent désormais
 * l'essentiel de chaque formule (`resume`, dans offres.js, qui ne dit rien que
 * le tableau ne dise déjà), et le tableau complet se déplie à la demande, dans
 * un <details> : rien n'est caché, rien n'est imposé. Déplié, il reste compact
 * sur mobile — trois colonnes étroites, plus une ligne par cellule.
 *
 * Les engagements et les conditions de sortie restent visibles, eux : c'est ce
 * qui distingue ce suivi d'une revente d'hébergement, et c'est ce qu'un
 * artisan méfiant veut lire avant tout le reste.
 *
 * ---- Le tableau lui-même ----
 *
 * Structure de la ressource Osmo « Comparison Table (Basic) » : une rangée
 * d'en-têtes collante, une ligne par prestation, les rôles ARIA de tableau
 * posés sur des blocs. Le coin de l'en-tête est un vrai en-tête de colonne,
 * masqué à l'œil seulement sur mobile (`sr-only`, jamais `display: none`). Le
 * mot « Kanyro » qui surmontait chaque nom de formule, en 10 px, a disparu :
 * il ne disait rien que la page ne dise déjà.
 *
 * Aucune formule mise en avant — ni pastille « recommandé », ni colonne
 * surlignée : pousser vers la plus chère un an avant la question se verrait.
 *
 * Le survol des lignes vient de la ressource Osmo « Directional List Hover » :
 * voir `initSurvolDirectionnel` dans effets.js.
 */

const { formules, comparatif } = offreMensuelle;
const tva = mentionTva();

/*
 * ⚠ `--formules` PASSE PAR UNE CLASSE, PAS PAR UN ATTRIBUT `style`.
 *
 * La CSP de Base.astro pose `style-src 'self'`, sans 'unsafe-inline' : un
 * `style="--formules: 2"` est bloqué sans bruit, la variable reste vide, et la
 * grille retombe sur une seule colonne. Les classes sont écrites en entier pour
 * que Tailwind les trouve à la compilation — une troisième formule demande une
 * troisième entrée ici.
 */
const colonnes = { 2: '[--formules:2]', 3: '[--formules:3]' }[formules.length];

/* Les colonnes du tableau : un intitulé souple, puis une colonne étroite par
   formule sur mobile, plus large sur grand écran. */
const grille =
  'grid grid-cols-[minmax(0,1fr)_repeat(var(--formules),6.5rem)] md:grid-cols-[minmax(0,1.4fr)_repeat(var(--formules),minmax(0,1fr))]';
---

{
  offreMensuelle.actif && (
    <section id="suivi" class="bg-surface px-4 py-24 sm:px-8 md:px-16 lg:px-28 lg:py-32">
      <div class="mx-auto max-w-6xl">
        <p class="surtitre reveal">Une fois le site en ligne</p>
        <h2 class="titre-section rideau mt-6 max-w-3xl">Hébergement et maintenance</h2>
        <p class="font-texte reveal mt-6 max-w-2xl text-base leading-relaxed text-texte-doux">
          {offreMensuelle.promesse}
        </p>

        {/*
          La phrase qui empêche les prix de la page de se concurrencer. Elle
          répond au « donc le site coûte 3 900 € PLUS 29 € par mois ? » qui se
          pose sinon en silence. Elle vient avant les montants : c'est en les
          lisant qu'on se pose la question.
        */}
        <p class="font-texte reveal mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-texte">
          Rien à régler aujourd'hui, et rien à signer. Le forfait démarre{' '}
          {offreMensuelle.demarrage}, et seulement si vous le décidez à ce moment-là.
        </p>

        <ul class="reveal mt-10 grid gap-4 md:grid-cols-2">
          {formules.map((f) => (
            <li class="carte flex flex-col p-6 sm:p-8">
              <p class="font-titre text-2xl tracking-wide sm:text-3xl">{f.nom}</p>
              <p class="mt-3 flex flex-wrap items-baseline gap-x-3">
                <span class="font-titre chiffres text-4xl font-light">{f.prix}</span>
                <span class="font-texte chiffres text-sm text-texte-faible">
                  ou {f.prixAnnuel}, {offreMensuelle.mentionAnnuel}
                </span>
              </p>
              <p class="font-texte mt-4 text-[0.9375rem] leading-relaxed text-texte-doux">
                {f.resume}
              </p>
            </li>
          ))}
        </ul>
        {tva && <p class="font-texte reveal mt-3 text-sm text-texte-faible">{tva}.</p>}

        <details class="group reveal mt-8">
          <summary class="font-texte inline-flex min-h-12 cursor-pointer list-none items-center gap-3 rounded-bouton border border-white/40 px-6 text-sm font-medium tracking-[0.08em] text-texte transition-colors hover:border-white [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden">Comparer les deux formules en détail</span>
            <span class="hidden group-open:inline">Replier le tableau</span>
            <ChevronDown class="h-4 w-4 transition-transform duration-300 group-open:rotate-180" stroke-width={1.5} aria-hidden="true" />
          </summary>

          <div
            role="table"
            aria-label="Les deux formules de suivi, comparées"
            class:list={['mt-6', colonnes]}
          >
            {/*
              L'en-tête est un enfant DIRECT du tableau : un élément collant ne
              glisse que dans la hauteur de son parent. `top-0`, et la place de la
              barre de navigation est DANS l'en-tête (`pt-16`), pas dans son
              décalage : un fond plein jusqu'en haut de l'écran masque les lignes
              qui défilent dessous.
            */}
            <div
              role="row"
              class:list={[grille, 'sticky top-0 z-10 border-b border-trait bg-surface pt-16 sm:pt-24']}
            >
              <div
                role="columnheader"
                class="font-texte flex items-end px-3 pb-4 text-xs tracking-[0.2em] text-texte-faible uppercase max-md:sr-only sm:px-5 sm:pb-6"
              >
                Ce qui est compris
              </div>
              {formules.map((f, i) => (
                <div
                  role="columnheader"
                  class:list={[
                    'flex flex-col items-center px-1 pb-4 text-center sm:px-2 sm:pb-6',
                    i === 0 && 'max-md:col-start-2',
                  ]}
                >
                  <p class="font-titre text-[0.8125rem] leading-tight break-words sm:text-2xl sm:tracking-wide">{f.nom}</p>
                  <p class="font-titre chiffres mt-1.5 text-lg leading-none font-light sm:mt-2 sm:text-3xl">
                    {f.prix}
                  </p>
                </div>
              ))}
            </div>

            {/*
              Survol directionnel : la ligne s'éclaire par le bord que franchit le
              curseur. Le cran est un voile blanc : une ligne sur deux porte déjà un
              voile de 2,5 %, un fond plein à peine plus clair y serait invisible.
            */}
            <div
              role="rowgroup"
              data-survol-directionnel="y"
              class="[--survol-fond:rgb(255_255_255/0.05)]"
            >
              {comparatif.map((ligne) => (
                <div
                  role="row"
                  data-survol-item
                  class:list={[grille, 'relative overflow-hidden border-b border-trait even:bg-white/[0.025]']}
                >
                  <div
                    data-survol-tuile
                    class="survol-tuile pointer-events-none absolute -inset-px"
                    aria-hidden="true"
                  >
                  </div>

                  <div role="rowheader" class="relative flex flex-col justify-center px-3 py-4 sm:px-5 md:py-5">
                    <p class="font-titre text-lg leading-snug tracking-wide sm:text-2xl">{ligne.titre}</p>
                    {ligne.detail && (
                      <p class="font-texte mt-1 text-sm leading-relaxed text-texte-faible">
                        {ligne.detail}
                      </p>
                    )}
                  </div>

                  {ligne.valeurs.map((v) => (
                    <div role="cell" class="relative flex items-center justify-center px-1 py-4 text-center md:py-5">
                      {v === true ? (
                        <>
                          <svg
                            class="h-5 w-5 text-texte"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="5 12 10 17 19 7" />
                          </svg>
                          <span class="sr-only">Compris</span>
                        </>
                      ) : v === false ? (
                        <>
                          <svg
                            class="h-5 w-5 text-white/45"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            aria-hidden="true"
                          >
                            <line x1="6" y1="12" x2="18" y2="12" />
                          </svg>
                          <span class="sr-only">Non compris</span>
                        </>
                      ) : v.note ? (
                        /* Le renvoi à la note porte sur tout le mot, pas sur le
                           seul astérisque : une cible de 6 px de large n'en est
                           pas une. */
                        <a
                          href="#suivi-note"
                          class="font-texte inline-flex min-h-11 items-center text-sm font-medium text-texte underline decoration-dotted underline-offset-4"
                          aria-label={`${v.texte}, voir la condition sous le tableau`}
                        >
                          {v.texte}*
                        </a>
                      ) : (
                        <p class="font-texte text-sm font-medium text-texte">{v.texte ?? v}</p>
                      )}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="font-texte mt-6 max-w-2xl space-y-2 text-sm leading-relaxed text-texte-faible">
            <p id="suivi-note">
              <span aria-hidden="true">* </span>
              {offreMensuelle.note}
            </p>
            <p>
              À l'année, en un seul règlement :{' '}
              <span class="text-signal-vif">{offreMensuelle.mentionAnnuel}</span> sur chaque
              formule.
            </p>
          </div>

          <div class="mt-10 max-w-2xl">
            <p class="surtitre">Ce qui n'est pas compris</p>
            <ul class="mt-4 space-y-3">
              {offreMensuelle.horsPerimetre.map((h) => (
                <li class="font-texte flex gap-3 text-[0.9375rem] text-texte-faible">
                  <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-white/40" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <div class="mt-16 grid gap-12 md:grid-cols-2 lg:gap-20">
          <div class="reveal">
            <p class="surtitre">Ce sur quoi je m'engage, dans les deux formules</p>
            {/*
              En orange, et seuls de la section à l'être avec la remise à
              l'année. C'est ce qui sépare ce suivi d'une revente d'hébergement
              avec marge : le reste, n'importe quel hébergeur le fait pour
              trente euros par an.
            */}
            <ul class="mt-4 space-y-3">
              {offreMensuelle.engagement.map((e) => (
                <li class="font-texte flex gap-3 text-[0.9375rem] leading-relaxed text-texte-doux">
                  <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-signal-vif" />
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="reveal">
            <p class="surtitre">Pour partir, ou ne rien prendre</p>
            <p class="font-texte mt-4 text-[0.9375rem] leading-relaxed text-texte-doux">
              {offreMensuelle.sortie}
            </p>
            <p class="font-texte mt-4 text-[0.9375rem] leading-relaxed text-texte-doux">
              Vous préférez ne rien prendre ? Comptez {offreMensuelle.alternative} pour garder
              le site en ligne à votre nom. Je vous aide à faire le transfert, et le site est
              à vous.
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}
