---
import { MEDIAS } from '../../config/medias.js';
import LienTelephone from '../LienTelephone.astro';
import Visuel from '../Visuel.astro';

/*
 * La fin de l'accueil : la phrase qui résume tout, sur le ciel, puis les deux
 * chemins.
 *
 * ---- Le ciel, et pourquoi il a failli partir ----
 *
 * La phrase était posée seule sur ce ciel pastel, en blanc sous un voile de
 * 25 % : 3,1:1 de contraste en médiane, 2,7:1 sur les zones claires (mesuré).
 * Et après elle, rien : ni bouton, ni pied de page. Le ciel avait été remplacé
 * par la brique de la Q&R le 11 septembre 2026 ; il est revenu le même jour,
 * parce que c'est la direction artistique du site (voir medias.js).
 *
 * Ce qui règle le contraste sans éteindre le ciel : un voile de 45 % sur toute
 * la section, et un halo sombre derrière le seul bloc de texte, plus dense au
 * centre. Le ciel reste lumineux sur les bords, le texte passe le niveau AA.
 * Le calcul est fait sur le plus clair du ciel (un jaune à 95 % de luminosité
 * en sRGB) : avec 45 % de voile et la moitié du halo, il reste 42 %, soit
 * 5,3:1 pour le blanc.
 *
 * ---- Le nuage de la couture ----
 *
 * Le même nuage que sous le hero, posé à cheval sur la couture avec la Q&R.
 * Il est HORS de la section, dans l'enveloppe : dedans, `overflow-hidden` le
 * couperait net à la couture, et la section d'avant l'aurait coupé de même.
 *
 * `-translate-y-1/2` pose la couture à 50 % de sa hauteur, là où il est plein
 * sur toute la largeur : ni la brique ni le ciel ne se voient au travers. Il
 * remonte donc de 25,5 vw par son quart gauche dans la Q&R, qui lui réserve
 * cette place en bas (QandA.astro). Le masque efface sa retombée sur le ciel,
 * de 70 à 86 % de sa hauteur, soit jusqu'à 20,4 vw sous la couture : le texte
 * commence juste après (`pt-[calc(21vw+2rem)]`).
 *
 * Le fondu de brique en haut de la section rattrape le seul endroit où le
 * nuage n'est pas tout à fait plein à la couture (son troisième quart).
 */
---

<div class="relative">
  <Visuel
    src={MEDIAS.nuageTransition}
    alt=""
    priorite="basse"
    decoratif
    sizes="100vw"
    largeurs={[640, 1280, 1920, 2688]}
    class="pointer-events-none absolute inset-x-0 top-0 z-[5] w-full -translate-y-1/2 select-none mask-b-from-70% mask-b-to-86%"
  />

  <section class="relative overflow-hidden bg-brique" aria-labelledby="titre-fin">
    <Visuel
      src={MEDIAS.fondCitation}
      alt=""
      decoratif
      sizes="100vw"
      largeurs={[640, 1280]}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-brique to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="contenu relative z-20 flex flex-col items-center pt-[calc(21vw+2rem)] text-center">
      {/* Le halo : un fond sombre derrière le texte seul, qui s'efface vers
          les bords. Derrière le contenu (`-z-10` dans son contexte), devant
          le ciel. */}
      <div
        class="pointer-events-none absolute inset-x-0 -top-16 bottom-[-4rem] -z-10 mt-[calc(21vw+2rem)] bg-[radial-gradient(closest-side,rgba(0,0,0,0.5),transparent)]"
        aria-hidden="true"
      >
      </div>

      <h2
        id="titre-fin"
        class="rideau font-titre max-w-3xl text-3xl leading-snug tracking-wide drop-shadow-[0_2px_20px_rgba(0,0,0,0.35)] sm:text-4xl lg:text-5xl lg:leading-tight"
      >
        Vos clients vous cherchent déjà.{' '}
        <span class="font-light italic">La question est de savoir qui ils trouvent.</span>
      </h2>

      <p class="font-texte reveal mt-7 max-w-xl text-base leading-relaxed text-white/90 [--retard:120ms]">
        Décrivez votre activité en deux lignes, ou appelez-moi. Je vous dis
        franchement si un site peut vous rapporter quelque chose.
      </p>

      <div
        class="reveal mt-10 flex w-full max-w-md flex-col items-stretch gap-3 [--retard:200ms] sm:w-auto sm:max-w-none sm:flex-row sm:items-center sm:justify-center"
      >
        <a href="/contact" data-bouton-anime data-mesure="devis" class="bouton-primaire">
          Demander un devis
        </a>
        <LienTelephone
          class="bouton-secondaire inline-flex items-center justify-center gap-2.5 bg-black/30 tracking-[0.12em] backdrop-blur-sm"
        />
      </div>

      <p class="font-texte reveal mt-5 text-sm text-white [--retard:260ms]">
        Réponse sous 48 heures, sans engagement.
      </p>
    </div>

    {/* Le voile de nuages, dans le flux : c'est la hauteur de l'image qui fait
        celle du bas de la section. Sa partie haute est transparente, la marge
        négative la glisse sous le texte sans le recouvrir (texte en `z-20`). */}
    <div class="pointer-events-none relative z-10 -mt-[10vw] select-none">
      <Visuel
        src={MEDIAS.voileBas}
        alt=""
        decoratif
        sizes="100vw"
        largeurs={[640, 1280, 1920]}
        class="block w-full"
      />
    </div>

    {/* Le raccord avec le pied de page, qui est sur le noir de la page : sans
        lui, les nuages s'arrêtaient sur une arête droite. */}
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[12vw] bg-gradient-to-b from-transparent to-fond"
      aria-hidden="true"
    >
    </div>
  </section>
</div>
