---
import { MEDIAS } from '../../config/medias.js';
---

<section class="relative min-h-screen w-full overflow-hidden">
  <img
    src={MEDIAS.fondCitation}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="pointer-events-none absolute inset-0 bg-black/25" aria-hidden="true"></div>

  <div
    class="relative z-20 flex min-h-screen items-center justify-center px-5 lg:items-start lg:justify-start lg:px-20 lg:pt-[25vh]"
  >
    <blockquote
      class="reveal-scale font-titre max-w-xs text-xl leading-snug text-white drop-shadow-[0_2px_20px_rgba(0,0,0,0.35)] sm:max-w-md sm:text-2xl md:max-w-xl md:text-3xl lg:max-w-2xl lg:text-5xl lg:leading-tight"
    >
      Vos clients vous cherchent déjà.
      <span class="font-light italic">
        La question est de savoir qui ils trouvent.
      </span>
    </blockquote>
  </div>

  {/* Voile bas en parallaxe : remonte doucement pendant le défilement. */}
  <img
    src={MEDIAS.voileBas}
    alt=""
    aria-hidden="true"
    data-parallaxe="80"
    class="pointer-events-none absolute -bottom-16 left-0 z-10 w-full will-change-transform select-none"
  />
</section>
