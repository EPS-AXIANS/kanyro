---
import { MEDIAS } from '../../config/medias.js';
---

{/*
  Marges négatives : elles font chevaucher le nuage de transition, le showcase et
  le hero, pour supprimer toute couture visible entre les sections.
*/}
<div class="relative z-20 -mt-64 sm:-mt-72 md:-mt-80 lg:-mt-96">
  <img
    src={MEDIAS.nuageTransition}
    alt=""
    aria-hidden="true"
    class="pointer-events-none w-full select-none"
  />
</div>

<div class="relative -mt-40 sm:-mt-48 md:-mt-56 lg:-mt-64">
  <section class="relative min-h-screen w-full overflow-hidden">
    <img
      src={MEDIAS.fondShowcase}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>

    <div
      class="relative z-10 flex min-h-screen flex-col items-center justify-center px-5 py-32 text-center text-white"
    >
      {/*
        « TROIS CHANTIERS » vient du premier écran, où il occupait le h1 sans
        jamais dire ce que fait l'agence. Ici il est chez lui : la section existe
        pour porter l'argument économique, et l'accroche garde toute sa force une
        fois qu'on sait de quoi on parle.
      */}
      <p class="surtitre reveal text-white/60">Le calcul est court</p>

      <h2
        class="reveal mt-6 leading-[1.05] drop-shadow-[0_2px_20px_rgba(0,0,0,0.3)] [animation-delay:100ms]"
      >
        <span
          class="font-arsenica block text-5xl tracking-wide sm:text-7xl md:text-8xl lg:text-[7rem]"
        >
          TROIS
        </span>
        <span
          class="font-inter block text-5xl font-semibold tracking-tight sm:text-7xl md:text-8xl lg:text-[7rem]"
        >
          CHANTIERS
        </span>
      </h2>

      <p
        class="reveal font-arsenica mt-10 max-w-3xl text-xl tracking-wide text-white/90 drop-shadow-[0_2px_16px_rgba(0,0,0,0.25)] [animation-delay:250ms] sm:text-2xl md:text-3xl"
      >
        Un chantier pèse entre cinq et vingt mille euros. Trois chantiers signés
        paient votre site — le reste, c'est ce qu'il vous rapporte les années
        suivantes.
      </p>

      <a
        href="/#offre"
        class="reveal font-inter mt-12 inline-block rounded-[50%] border border-white/50 px-10 py-4 text-[10px] font-medium tracking-[0.25em] text-white uppercase no-underline transition-all duration-500 [animation-delay:400ms] hover:scale-[1.03] hover:border-white hover:bg-white/10 hover:shadow-[0_0_30px_rgba(255,255,255,0.1)] sm:px-12 sm:py-5 sm:text-xs"
      >
        Voir l'offre
      </a>
    </div>

    {/* Fond du dégradé accordé au brun de la section Q&R qui suit. */}
    <div
      class="absolute bottom-0 left-0 h-48 w-full bg-gradient-to-b from-transparent to-[#410C01]"
      aria-hidden="true"
    >
    </div>
  </section>

  <img
    src={MEDIAS.colombe}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-4 -bottom-12 z-20 w-24 select-none sm:right-8 sm:-bottom-16 sm:w-32 md:w-48 lg:right-16 lg:w-64"
  />
</div>
